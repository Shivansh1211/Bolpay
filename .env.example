# Database Configuration
POSTGRES_DB=bolpay
POSTGRES_USER=bolpay_user
POSTGRES_PASSWORD=bolpay_password

# JWT Configuration (minimum 256 bits for production)
JWT_SECRET=bolpay-secret-key-change-in-production-min-256-bits

# Network Configuration
# PUBLIC_BASE_URL: URL accessible from customer phones (LAN IP or tunnel)
# Example: http://192.168.1.100:5173 or https://your-tunnel-url.ngrok.io
PUBLIC_BASE_URL=http://localhost:5173

# Payment Gateway Configuration
# Options: mock (default, no keys needed), cashfree
PAYMENT_GATEWAY_TYPE=mock

# Mock Cashfree Configuration
# CASHFREE_INTERNAL_URL: URL used by backend to call mock gateway (Docker hostname)
CASHFREE_INTERNAL_URL=http://mock-cashfree:9000
# CASHFREE_PUBLIC_URL: URL used by browser to open mock checkout (must be reachable from phone)
CASHFREE_PUBLIC_URL=http://localhost:9000

# Cashfree Configuration (only if PAYMENT_GATEWAY_TYPE=cashfree)
CASHFREE_APP_ID=
CASHFREE_APP_SECRET=
CASHFREE_API_URL=https://sandbox.cashfree.com/pg

# ML Service Configuration
ML_SERVICE_URL=http://ml-service:5000

# CORS Configuration (comma-separated for multiple origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Spring Profile
SPRING_PROFILES_ACTIVE=dev
