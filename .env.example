# Database Configuration
POSTGRES_DB=bolpay
POSTGRES_USER=bolpay_user
POSTGRES_PASSWORD=bolpay_mock_dev_password

# JWT Configuration (minimum 256 bits for production)
JWT_SECRET=replace-with-local-random-secret

# Network Configuration
# PUBLIC_BASE_URL: URL accessible from customer phones (LAN IP or tunnel)
# Example: http://192.168.1.100:5173 or https://your-tunnel-url.ngrok.io
PUBLIC_BASE_URL=http://localhost:5173

# Payment Gateway Configuration
# Options: mock (default, no keys needed), cashfree
PAYMENT_GATEWAY=mock

# Mock Cashfree Configuration
# CASHFREE_BASE_URL: gateway API base URL (Docker hostname for the local mock)
CASHFREE_BASE_URL=http://mock-cashfree:9000
CASHFREE_CLIENT_ID=bolpay-mock-client
CASHFREE_CLIENT_SECRET=bolpay-mock-client-secret
CASHFREE_WEBHOOK_SECRET=bolpay-mock-webhook-secret

# Cashfree Configuration (only if PAYMENT_GATEWAY=cashfree)
# Cashfree is not required for the simulated-money development flow.

# ML Service Configuration
ML_SERVICE_URL=http://ml-service:5000

# CORS Configuration (comma-separated for multiple origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Spring Profile
SPRING_PROFILES_ACTIVE=dev
